<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="44dp" android:paddingBottom="36dp">
    <TextView android:id="@+id/state" style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"/>
    <FrameLayout android:layout_width="104dp" android:layout_height="104dp" android:layout_gravity="center_horizontal" android:layout_marginTop="26dp" android:clipChildren="false">
      <View android:id="@+id/ring1" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_ring" android:alpha="0"/>
      <View android:id="@+id/ring2" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_ring" android:alpha="0"/>
      <TextView android:id="@+id/avatar" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_avatar" android:gravity="center" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
      <ImageView android:id="@+id/avatar_icon" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:src="@drawable/ic_tab_contacts" android:visibility="gone"/>
    </FrameLayout>
    <TextView android:id="@+id/who" style="@style/Text" android:textSize="31sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:letterSpacing="-0.02" android:fontFeatureSettings="tnum" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/sub" style="@style/Text.Meta" android:textSize="15sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
    <TextView android:id="@+id/timer" style="@style/Text" android:textSize="17sp" android:fontFeatureSettings="tnum" android:textColor="@color/ink_2" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    <LinearLayout android:id="@+id/rec" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_gravity="center_horizontal" android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_rec_pill" android:paddingStart="12dp" android:paddingEnd="13dp" android:visibility="invisible">
      <ImageView android:id="@+id/rec_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot" android:tint="@color/danger"/>
      <TextView android:id="@+id/rec_text" style="@style/Text" android:textSize="12.5sp" android:textColor="@color/danger" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Grabando"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/context_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal" android:background="@drawable/bg_surface" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:visibility="gone">
      <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="1dp" android:src="@drawable/ic_hist" android:tint="@color/accent"/>
      <TextView android:id="@+id/context" style="@style/Text" android:textSize="15sp" android:lineSpacingExtra="4dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:maxLines="3" android:ellipsize="end"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <LinearLayout android:id="@+id/dtmf" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
      <TextView android:id="@+id/dtmf_digits" style="@style/Text" android:textSize="26sp" android:fontFeatureSettings="tnum" android:gravity="center" android:singleLine="true" android:ellipsize="start" android:layout_width="match_parent" android:layout_height="40dp"/>
      <LinearLayout android:id="@+id/dtmf_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/sim_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp" android:visibility="gone"/>

    <TextView android:id="@+id/btn_mark" style="@style/Text" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="22dp" android:background="@drawable/bg_btn_surface" android:gravity="center" android:drawableStart="@drawable/ic_bookmark" android:drawableTint="@color/accent" android:drawablePadding="8dp" android:paddingStart="20dp" android:paddingEnd="22dp" android:textSize="14.5sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="@color/accent" android:text="Marcar momento" android:visibility="gone"/>

    <LinearLayout android:id="@+id/controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <ImageButton android:id="@+id/btn_mute" android:layout_width="68dp" android:layout_height="68dp" android:background="@drawable/bg_ctl" android:src="@drawable/ic_mic_off" android:contentDescription="Silenciar"/>
        <TextView style="@style/Text.Meta" android:textSize="12.5sp" android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Silenciar"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <ImageButton android:id="@+id/btn_keypad" android:layout_width="68dp" android:layout_height="68dp" android:background="@drawable/bg_ctl" android:src="@drawable/ic_dialpad" android:contentDescription="Teclado"/>
        <TextView style="@style/Text.Meta" android:textSize="12.5sp" android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Teclado"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <ImageButton android:id="@+id/btn_speaker" android:layout_width="68dp" android:layout_height="68dp" android:background="@drawable/bg_ctl" android:src="@drawable/ic_speaker" android:contentDescription="Altavoz"/>
        <TextView android:id="@+id/speaker_label" android:singleLine="true" android:ellipsize="end" android:maxWidth="96dp" style="@style/Text.Meta" android:textSize="12.5sp" android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Altavoz"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <ImageButton android:id="@+id/btn_hold" android:layout_width="68dp" android:layout_height="68dp" android:background="@drawable/bg_ctl" android:src="@drawable/ic_hold" android:contentDescription="Espera"/>
        <TextView style="@style/Text.Meta" android:textSize="12.5sp" android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Espera"/>
      </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/quick" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:layout_marginBottom="32dp">
      <TextView android:id="@+id/btn_msg" style="@style/Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_marginEnd="5dp" android:background="@drawable/bg_btn2" android:gravity="center" android:drawableStart="@drawable/ic_msg" android:drawableTint="@color/accent" android:drawablePadding="8dp" android:paddingStart="22dp" android:paddingEnd="22dp" android:textSize="14.5sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="@color/accent" android:text="Mensaje"/>
      <TextView android:id="@+id/btn_later" style="@style/Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_marginStart="5dp" android:background="@drawable/bg_btn2" android:gravity="center" android:drawableStart="@drawable/ic_alarm" android:drawableTint="@color/accent" android:drawablePadding="8dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="14.5sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="@color/accent" android:text="Recordarme"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/ringing" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <ImageButton android:id="@+id/btn_reject" android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/bg_circle_danger" android:src="@drawable/ic_call_end" android:tint="#FFFFFF" android:padding="22dp" android:scaleType="fitCenter" android:contentDescription="Rechazar"/>
        <TextView style="@style/Text.Meta" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Rechazar"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <ImageButton android:id="@+id/btn_answer" android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/bg_circle_ok" android:src="@drawable/ic_call" android:tint="#FFFFFF" android:padding="22dp" android:scaleType="fitCenter" android:contentDescription="Contestar"/>
        <TextView style="@style/Text.Meta" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Contestar"/>
      </LinearLayout>
    </LinearLayout>

    <ImageButton android:id="@+id/btn_end" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center_horizontal" android:layout_marginTop="30dp" android:background="@drawable/bg_circle_danger" android:src="@drawable/ic_call_end" android:tint="#FFFFFF" android:padding="22dp" android:scaleType="fitCenter" android:contentDescription="Colgar"/>
  </LinearLayout>
</FrameLayout>
