<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="8dp">
    <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:background="@drawable/bg_icon_btn" android:contentDescription="Volver"/>
    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
    <ImageButton android:id="@+id/btn_fav" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_star" android:background="@drawable/bg_icon_btn" android:contentDescription="Añadir a favoritas"/>
    <ImageButton android:id="@+id/btn_more" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_more" android:background="@drawable/bg_icon_btn" android:contentDescription="Más opciones"/>
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="28dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingBottom="18dp">
        <FrameLayout android:layout_width="68dp" android:layout_height="68dp">
          <TextView android:id="@+id/avatar" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_avatar" android:gravity="center" android:textSize="23sp" android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
          <ImageView android:id="@+id/avatar_icon" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/ic_tab_contacts" android:visibility="gone"/>
        </FrameLayout>
        <TextView android:id="@+id/number" style="@style/Text" android:textSize="25sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:letterSpacing="-0.02" android:fontFeatureSettings="tnum" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textIsSelectable="true"/>
        <TextView android:id="@+id/name" style="@style/Text.Meta" android:textSize="14sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/kind" style="@style/Text.Meta" android:textSize="14sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
      </LinearLayout>

      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <ImageButton android:id="@+id/btn_play" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_circle_accent" android:src="@drawable/ic_play" android:tint="@color/on_accent" android:padding="15dp" android:scaleType="fitCenter" android:contentDescription="Reproducir"/>
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="6dp">
            <SeekBar android:id="@+id/seek" android:layout_width="match_parent" android:layout_height="28dp" android:progressDrawable="@drawable/seek_track" android:thumb="@drawable/seek_thumb" android:splitTrack="false" android:paddingStart="8dp" android:paddingEnd="8dp" android:maxHeight="6dp" android:minHeight="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
              <TextView android:id="@+id/pos" style="@style/Text.Meta" android:textSize="12.5sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="0:00"/>
              <TextView android:id="@+id/len" style="@style/Text.Meta" android:textSize="12.5sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00"/>
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp"/>
      </LinearLayout>

      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <TextView android:id="@+id/act_call" style="@style/Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="72dp" android:background="@drawable/bg_card_click" android:gravity="center" android:drawableTop="@drawable/ic_call_small" android:drawableTint="@color/accent" android:drawablePadding="6dp" android:paddingTop="12dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="@color/accent" android:text="Llamar"/>
        <TextView android:id="@+id/act_wa" style="@style/Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="72dp" android:layout_marginStart="10dp" android:background="@drawable/bg_card_click" android:gravity="center" android:drawableTop="@drawable/ic_msg" android:drawableTint="@color/accent" android:drawablePadding="6dp" android:paddingTop="12dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="@color/accent" android:text="WhatsApp"/>
        <TextView android:id="@+id/act_share" style="@style/Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="72dp" android:layout_marginStart="10dp" android:background="@drawable/bg_card_click" android:gravity="center" android:drawableTop="@drawable/ic_share" android:drawableTint="@color/accent" android:drawablePadding="6dp" android:paddingTop="12dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="@color/accent" android:text="Compartir"/>
      </LinearLayout>

      <LinearLayout android:id="@+id/ai" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

      <TextView style="@style/Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingTop="24dp" android:paddingBottom="8dp" android:text="Detalles"/>
      <LinearLayout android:id="@+id/facts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card"/>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
