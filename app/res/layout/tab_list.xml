<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" android:clipToPadding="false" android:paddingBottom="20dp" android:listSelector="@android:color/transparent" android:scrollbarStyle="outsideOverlay"/>
  <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingBottom="60dp" android:visibility="gone">
    <FrameLayout android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/bg_circle_soft"><ImageView android:id="@+id/empty_icon" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/ic_tab_recents" android:tint="@color/accent"/></FrameLayout>
    <TextView android:id="@+id/empty_title" style="@style/Text" android:textSize="19sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"/>
    <TextView android:id="@+id/empty_sub" style="@style/Text.Meta" android:textSize="14.5sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:lineSpacingExtra="4dp"/>
  </LinearLayout>
</FrameLayout>
