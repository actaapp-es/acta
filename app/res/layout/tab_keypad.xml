<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingBottom="16dp">
  <View android:id="@+id/digits_area" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  <TextView android:id="@+id/digits" style="@style/Text" android:textSize="38sp" android:fontFeatureSettings="tnum" android:letterSpacing="0.02" android:gravity="center" android:singleLine="true" android:ellipsize="start" android:layout_width="match_parent" android:layout_height="52dp" android:textIsSelectable="false"/>
  <TextView android:id="@+id/digits_match" style="@style/Text.Meta" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginBottom="12dp"/>
  <LinearLayout android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginTop="10dp">
    <ImageButton android:id="@+id/btn_dial" android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="center" android:src="@drawable/ic_call" android:background="@drawable/bg_circle_ok" android:contentDescription="Llamar" android:tint="#FFFFFF" android:padding="22dp" android:scaleType="fitCenter"/>
    <ImageButton android:id="@+id/btn_del" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center_vertical|end" android:layout_marginEnd="14dp" android:src="@drawable/ic_backspace" android:tint="@color/ink_2" android:background="@drawable/bg_icon_btn" android:contentDescription="Borrar" android:visibility="invisible"/>
  </FrameLayout>
</LinearLayout>
